---
import * as Alert from './ui/alert/index.js';
import { Spinner } from './ui/spinner/index.js';
import ScrollRegion from './site/ScrollRegion.svelte';
import { Code } from 'astro:components';
import githubLight from '@shikijs/themes/github-light';
import Button from './site/Button.svelte';
import ExampleFileTabs from './site/ExampleFileTabs.svelte';
import { exampleCopy } from '../examples/catalog';
import { getSolution, type ExampleFile } from '../examples/solutions';
import type { ExampleDefinition, ExampleId, Locale } from '../examples/definitions';

interface Props {
  definition: ExampleDefinition;
  exampleId: ExampleId;
  locale: Locale;
}

const { definition, exampleId, locale } = Astro.props;
const text = exampleCopy[locale];
const files: { key: ExampleFile; name: string; source: string }[] = [
  { key: 'view', name: 'view.json', source: JSON.stringify(definition.view, null, 2) },
  ...(definition.resources ? [{ key: 'resources' as const, name: 'resources.json', source: JSON.stringify(definition.resources, null, 2) }] : []),
  ...(definition.inputs ? [{ key: 'inputs' as const, name: 'inputs.json', source: JSON.stringify(definition.inputs, null, 2) }] : []),
];
const solution = getSolution(exampleId, locale, Object.fromEntries(files.map(({ key, source }) => [key, source])));
---

<section
  class="example-workbench"
  aria-label={text.source}
  data-example-preview
  data-locale={locale}
  data-fixture={definition.fixture}
  data-error={text.error}
  data-retained={text.retained}
  data-editor-error={text.editorError}
>
  <div class="example-editor" id="example-code">
    <header>
      {files.length > 1 ? (
        <ExampleFileTabs files={files.map(({ key, name }) => ({ key, name }))} label={text.sourceFiles} client:load />
      ) : (
        <code>{files[0].name}</code>
      )}
      <span class="example-auto-run" data-example-editor-mode data-draft-label={text.autoRun} data-solution-label={text.solutionCode}>{text.autoRun}</span>
      <a class="example-mobile-link" href="#example-result">{text.toPreview}</a>
    </header>
    {files.map((file, index) => (
      <div id={"source-" + file.key} data-source-key={file.key} data-source-name={file.name} hidden={index !== 0}>
        <ScrollRegion class="editor-scroll" client:load><div data-editor-host hidden></div>
        <div data-editor-fallback>
          <Code code={file.source} lang="json" theme={githubLight} />
        </div></ScrollRegion>
        <textarea data-source-original hidden readonly aria-hidden="true" tabindex="-1">{file.source}</textarea>
        {solution[file.key] && <textarea data-source-solution hidden readonly aria-hidden="true" tabindex="-1">{solution[file.key]}</textarea>}
      </div>
    ))}
  </div>
  <div class="example-preview" id="example-result">
    <header>
      <h2>{text.preview}</h2>
      <a class="example-mobile-link" href="#example-code">{text.toCode}</a>
      <div class="example-result-actions">
        <Button data-example-solution data-show-label={text.showSolution} data-restore-label={text.restoreDraft}
          type="button" variant="outline" size="sm" aria-controls="example-code example-preview-content" disabled>{text.showSolution}</Button>
        <Button data-example-run size="sm" aria-keyshortcuts="Control+Enter Meta+Enter" disabled>{text.run}</Button>
      </div>
    </header>
    <p data-example-running role="status" hidden><Spinner aria-hidden="true" /> {text.running}</p>
    <Alert.Root variant="destructive" data-example-status hidden><Alert.Description><span data-example-error-message></span></Alert.Description></Alert.Root>
    <ScrollRegion class="preview-scroll" client:load><div id="example-preview-content" data-example-target></div></ScrollRegion>
  </div>
</section>

<script>
  import type { JsonValue, ViewSpec, AnyResource } from '@viewstem/core';
  import type { EditorState as EditorSnapshot } from '@codemirror/state';
  import type { ExampleDefinition, Locale } from '../examples/definitions';
  import type { createJsonEditor } from '../lib/json-editor';
  import type { createExamplePreview } from '../examples/preview';
  import { playMotion } from '../lib/site-motion';

  const container = document.querySelector<HTMLElement>('[data-example-preview]');

  async function setup(container: HTMLElement) {
    const runButton = container.querySelector<HTMLButtonElement>('[data-example-run]')!;
    const solutionButton = container.querySelector<HTMLButtonElement>('[data-example-solution]')!;
    const editorMode = container.querySelector<HTMLElement>('[data-example-editor-mode]')!;
    const resetButton = document.querySelector<HTMLButtonElement>('[data-example-reset]')!;
    const jumpButton = document.querySelector<HTMLButtonElement>('[data-example-jump]')!;
    const sourcePanels = container.querySelectorAll<HTMLElement>('[data-source-key]');
    const target = container.querySelector<HTMLElement>('[data-example-target]')!;
    const status = container.querySelector<HTMLElement>('[data-example-status]')!;
    const progress = container.querySelector<HTMLElement>('[data-example-running]')!;
    const { locale, fixture, error, retained, editorError } = container.dataset;
    const editors = new Map<string, ReturnType<typeof createJsonEditor>>();
    const originals = new Map<string, string>();
    const changedSources = new Map<string, string>();
    const draftStates = new Map<string, EditorSnapshot>();
    type PreviewSession = {
      preview?: ReturnType<typeof createExamplePreview>;
      surface?: HTMLDivElement;
      error?: string;
      runFailed?: boolean;
    };
    const draft: PreviewSession = {};
    const solution: PreviewSession = {};
    let active = draft;
    let draftFile = 'view';
    let draftPending = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let running = false;
    let queued = false;

    function showStatus() {
      status.querySelector<HTMLElement>('[data-example-error-message]')!.textContent = active.error ?? '';
      status.hidden = !active.error;
    }

    function showError(message: string, session = active) {
      session.error = message;
      if (session === active) showStatus();
    }

    function readFile(key: string) {
      const editor = editors.get(key);
      if (!editor) return undefined;
      try {
        return JSON.parse(editor.state.doc.toString()) as unknown;
      } catch (cause) {
        const detail = cause instanceof Error ? cause.message : '';
        throw new Error(`${key}.json · ${detail}`);
      }
    }

    async function run() {
      clearTimeout(timer);
      if (running) {
        queued = true;
        return;
      }
      const session = active;
      if (session === draft) draftPending = false;
      running = true;
      session.runFailed = false;
      session.error = undefined;
      runButton.disabled = true;
      solutionButton.setAttribute('aria-disabled', 'true');
      resetButton.disabled = session === solution;
      showStatus();
      progress.hidden = false;
      const surface = document.createElement('div');
      let next: PreviewSession['preview'];

      try {
        const source: ExampleDefinition = {
          view: readFile('view') as ViewSpec,
          resources: readFile('resources') as AnyResource[] | undefined,
          inputs: readFile('inputs') as Record<string, JsonValue> | undefined,
          fixture: fixture === 'availability' || fixture === 'reservation' ? fixture : undefined,
        };
        const { createExamplePreview } = await import('../examples/preview');
        surface.hidden = true;
        target.append(surface);
        next = createExamplePreview(surface, source, locale as Locale, diagnostic => {
          if (session.preview === next && !session.runFailed) showError(diagnostic.error.message, session);
        });
        await next.run();
        const previous = session.surface;
        await session.preview?.dispose();
        session.preview = next;
        session.surface = surface;
        surface.hidden = false;
        previous?.remove();
        playMotion(surface, [{ opacity: 0.65 }, { opacity: 1 }], { duration: 180 });
      } catch (cause) {
        session.runFailed = true;
        await next?.dispose().catch(() => {});
        surface.remove();
        const detail = typeof cause === 'object' && cause && 'message' in cause ? String(cause.message) : '';
        showError([error, detail, session.preview && retained].filter(Boolean).join(' '), session);
      } finally {
        running = false;
        progress.hidden = true;
        runButton.disabled = false;
        resetButton.disabled = false;
        solutionButton.removeAttribute('aria-disabled');
        if (queued) {
          queued = false;
          void run();
        }
      }
    }

    function scheduleRun() {
      if (active !== draft) return;
      draftPending = true;
      clearTimeout(timer);
      timer = setTimeout(() => void run(), 450);
    }

    function showFile(key: string) {
      for (const file of sourcePanels) file.hidden = file.dataset.sourceKey !== key;
      container.dataset.activeFile = key;
      container.dispatchEvent(new Event('example-file-state'));
      const editor = editors.get(key);
      editor?.requestMeasure();
      return editor;
    }

    function showMode() {
      const solved = active === solution;
      container.dataset.exampleMode = solved ? 'solution' : 'draft';
      solutionButton.textContent = (solved ? solutionButton.dataset.restoreLabel : solutionButton.dataset.showLabel) ?? '';
      editorMode.textContent = (solved ? editorMode.dataset.solutionLabel : editorMode.dataset.draftLabel) ?? '';
      showStatus();
    }

    function changedRange(original: string, updated: string) {
      let from = 0;
      while (from < original.length && from < updated.length && original[from] === updated[from]) from++;
      let before = original.length;
      let to = updated.length;
      while (before > from && to > from && original[before - 1] === updated[to - 1]) {
        before--;
        to--;
      }
      return { anchor: from, head: to };
    }

    try {
      const [{ createJsonEditor }, { EditorView }, { EditorState, StateEffect }] = await Promise.all([
        import('../lib/json-editor'),
        import('@codemirror/view'),
        import('@codemirror/state'),
      ]);
      for (const file of sourcePanels) {
        const key = file.dataset.sourceKey!;
        const host = file.querySelector<HTMLElement>('[data-editor-host]')!;
        const fallback = file.querySelector<HTMLElement>('[data-editor-fallback]')!;
        const source = file.querySelector<HTMLTextAreaElement>('[data-source-original]')!.value;
        originals.set(key, source);
        const changed = file.querySelector<HTMLTextAreaElement>('[data-source-solution]');
        if (changed) changedSources.set(key, changed.value);
        editors.set(key, createJsonEditor({
          parent: host,
          source,
          label: file.dataset.sourceName ?? key,
          onChange: scheduleRun,
          onRun: () => void run(),
        }));
        fallback.hidden = true;
        host.hidden = false;
      }

      container.dataset.filesReady = 'true';
      container.dispatchEvent(new Event('example-file-state'));
      container.addEventListener('example-file-change', (event) => showFile((event as CustomEvent<string>).detail));
      showMode();
      solutionButton.disabled = false;

      function restoreDraft() {
        for (const [key, state] of draftStates) editors.get(key)!.setState(state);
        draftStates.clear();
        const previous = solution.preview;
        solution.surface?.remove();
        solution.surface = undefined;
        solution.preview = undefined;
        solution.error = undefined;
        active = draft;
        if (draft.surface) target.append(draft.surface);
        showFile(draftFile);
        showMode();
        void previous?.dispose().catch(() => {});
      }

      solutionButton.addEventListener('click', () => {
        if (running) return;
        if (active === solution) {
          restoreDraft();
          if (draftPending) void run();
          return;
        }
        clearTimeout(timer);
        draftFile = container.dataset.activeFile ?? 'view';
        active = solution;
        // Keep the draft runtime alive without leaving duplicate form IDs in the document.
        draft.surface?.remove();
        for (const [key, editor] of editors) {
          draftStates.set(key, editor.state);
          const original = originals.get(key)!;
          const changed = changedSources.get(key);
          const source = changed ?? original;
          const selection = changed ? changedRange(original, changed) : { anchor: 0 };
          editor.setState(editor.state.update({
            changes: { from: 0, to: editor.state.doc.length, insert: source },
            selection,
            effects: StateEffect.appendConfig.of([
              EditorState.readOnly.of(true), EditorView.editable.of(false),
              EditorView.contentAttributes.of({ tabindex: '0' }),
            ]),
          }).state);
        }
        const key = jumpButton.dataset.file!;
        const editor = showFile(key);
        if (editor) editor.dispatch({ effects: EditorView.scrollIntoView(editor.state.selection.main, { y: 'center' }) });
        showMode();
        void run();
      });

      jumpButton.disabled = false;
      jumpButton.addEventListener('click', () => {
        const editor = showFile(jumpButton.dataset.file!);
        if (!editor) return;
        if (active === solution) {
          editor.dispatch({ effects: EditorView.scrollIntoView(editor.state.selection.main, { y: 'center' }) });
          editor.focus();
          return;
        }
        const offset = editor.state.doc.toString().indexOf(jumpButton.dataset.find!);
        if (offset >= 0) editor.dispatch({
          selection: { anchor: offset },
          effects: EditorView.scrollIntoView(offset, { y: 'center' }),
        });
        editor.focus();
      });
      resetButton.disabled = false;
      resetButton.addEventListener('click', () => {
        if (active === solution) {
          if (running) return;
          restoreDraft();
        }
        for (const [key, editor] of editors) {
          editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: originals.get(key) ?? '' } });
        }
        void run();
      });
      runButton.addEventListener('click', () => void run());
      function dismissActionError() {
        if (!active.runFailed && active.error) {
          active.error = undefined;
          showStatus();
        }
      }
      target.addEventListener('click', dismissActionError, { capture: true });
      target.addEventListener('input', dismissActionError, { capture: true });
      void run();
    } catch {
      showError(editorError ?? '');
    }
  }

  if (container) void setup(container);
</script>
