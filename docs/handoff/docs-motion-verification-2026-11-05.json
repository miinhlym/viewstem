  "audit": {
    "filter": {
      "state": "\"all\"",
      "rows": 3,
      "animations": [
        {
          "target": "TR",
          "duration": 240,
          "delay": 0
        },
        {
          "target": "OUTPUT",
          "duration": 420,
          "delay": 0
        },
        {
          "target": "SPAN",
          "duration": 240,
          "delay": 0
        },
        {
          "target": "H3",
          "duration": 420,
          "delay": 0
        },
        {
          "target": "H3",
          "duration": 420,
          "delay": 90
        },
        {
          "target": "H3",
          "duration": 420,
          "delay": 180
        },
        {
          "target": "H3",
          "duration": 420,
          "delay": 270
        }
      ]
    },
    "reducedDuringMotion": {
      "reduced": true,
