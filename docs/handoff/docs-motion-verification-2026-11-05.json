        {
          "opacity": "1",
          "transform": "none"
        },
        {
          "opacity": "1",
          "transform": "none"
        },
        {
          "opacity": "1",
          "transform": "none"
        }
      ]
    },
    "reducedFilter": {
      "rows": 2,
      "state": "\"active\"",
      "animations": 0
    },
    "reducedAfterMediaEvent": {
      "reduced": true,
      "animations": 0
    },
    "rapid": {
      "state": "\"all\"",
      "rows": 3,
      "headingAnimations": [
        1,
        1,
        1,
        1
      ]
    },
    "settled": {
      "animations": 0,
      "inlineStyles": [
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null
      ]
    },
    "entryFirst": {
      "count": 1,
      "frames": [
        {
          "opacity": "0.65",
          "transform": "translateY(6px)"
        },
        {
          "opacity": "1",
          "transform": "translateY(0px)"
        }
      ]
    },
    "entryRepeat": {
      "count": 0
    },
    "mobileMenu": {
      "expanded": "true",
      "inert": true,
      "animation": "site-panel-enter",
      "duration": "0.2s"
    },
    "menuEscape": {
      "expanded": "false",
