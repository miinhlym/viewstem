    },
    "reducedMenu": {
      "animation": "none",
      "expanded": "true"
    },
    "noScript": {
      "title": "화면과 동작을 JSON으로 정의하세요. ",
      "visible": [
        {
          "opacity": "1",
          "visibility": "visible",
          "display": "block"
        },
        {
          "opacity": "1",
          "visibility": "visible",
          "display": "block"
        },
        {
          "opacity": "1",
          "visibility": "visible",
          "display": "block"
