    "exampleResult": {
      "text": "안녕, Viewstem",
      "animations": [
        {
          "duration": 180,
          "frames": [
            "0.65",
            "1"
          ]
        }
      ]
    },
    "exampleError": {
      "message": "예제를 실행하지 못했습니다. view.json · Expected property name or '}' in JSON at position 1 (line 1 column 2) 마지막으로 성공한 결과를 표시합니다.",
      "animation": "site-feedback-enter",
      "retained": "안녕, Viewstem"
    },
    "exampleMenu": {
      "open": true,
      "animation": "site-panel-enter"
    },
    "playgroundError": {
      "animation": "site-feedback-enter",
