{
  "name": "viewstem-workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miinhlym/viewstem.git"
  },
  "bugs": {
    "url": "https://github.com/miinhlym/viewstem/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/docs"
  ],
  "scripts": {
    "dev:docs": "npm run dev -w @viewstem/docs",
    "build:docs": "npm run build -w @viewstem/docs",
    "preview:docs": "npm run preview -w @viewstem/docs",
    "test:ci": "node --test .github/scripts/*.test.mjs",
    "build": "npm run build -w @viewstem/core",
    "test": "npm run test -w @viewstem/core",
    "typecheck": "npm run typecheck -w @viewstem/core",
    "check": "npm run build && npm run test:report && npm run typecheck && npm run check:coverage",
    "test:browser": "node packages/core/test/cel-browser.mjs && node packages/core/test/browser.mjs",
    "test:package": "node packages/core/scripts/test-package.mjs",
    "check:coverage": "node packages/core/scripts/check-coverage.mjs packages/core/test/results/current.json",
    "test:report": "node packages/core/scripts/run-tests.mjs",
    "build:svelte": "npm run build && npm run build -w @viewstem/svelte",
    "check:svelte": "npm run build:svelte && npm run typecheck -w @viewstem/svelte && npm run test -w @viewstem/svelte && npm run test:svelte:package",
    "test:svelte": "npm run build:svelte && npm run test -w @viewstem/svelte",
    "test:svelte:package": "node packages/svelte/scripts/test-package.mjs",
    "example:svelte": "npm run build:svelte && node packages/svelte/example/server.mjs",
    "postinstall": "patch-package --error-on-fail",
    "typecheck:docs": "npm run typecheck -w @viewstem/docs",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "build:ui": "npm run build && npm run build -w @viewstem/ui",
    "check:ui": "npm run build:ui && npm run test -w @viewstem/ui"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@marcbachmann/cel-js": "8.0.0",
    "@sveltejs/package": "2.5.8",
    "@tailwindcss/oxide": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "esbuild": "0.25.12",
    "patch-package": "8.0.1",
    "playwright": "1.62.1",
    "postcss": "8.5.8",
    "postcss-selector-parser": "7.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@astrojs/starlight": {
      "@astrojs/markdown-remark": "7.2.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
