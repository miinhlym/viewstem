{
  "name": "@viewstem/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miinhlym/viewstem.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/miinhlym/viewstem/issues"
  },
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-independent declarative UI runtime",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./cel": {
      "types": "./dist/cel.d.ts",
      "import": "./dist/cel.js"
    },
    "./cel-support.json": "./dist/cel-support.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p test/types/tsconfig.json"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "ajv": "8.20.0",
    "re2js": "2.9.1"
  }
}
