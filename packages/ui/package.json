{
  "name": "@viewstem/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-independent browser UI for Viewstem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miinhlym/viewstem.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./support.json": "./dist/support.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-catalog.mjs && node scripts/build-basecoat.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.0",
    "@tanstack/table-core": "9.0.0",
    "@viewstem/core": "0.1.0",
    "@zag-js/date-picker": "1.47.0",
    "@zag-js/hover-card": "1.47.0",
    "@zag-js/menu": "1.47.0",
    "@zag-js/navigation-menu": "1.47.0",
    "@zag-js/scroll-area": "1.47.0",
    "@zag-js/slider": "1.47.0",
    "@zag-js/splitter": "1.47.0",
    "@zag-js/vanilla": "1.47.0",
    "d3-scale": "4.0.2",
    "embla-carousel": "8.6.0"
  },
  "devDependencies": {
    "@types/d3-scale": "4.0.9",
    "basecoat-css": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "3.5.45"
  }
}
